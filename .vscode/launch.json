{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "BMS Web (Port 8000)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "envFile": "${workspaceFolder}/.env",
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "BMS Web (Port 3000)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "3000"
            ],
            "envFile": "${workspaceFolder}/.env",
            "jinja": true,
            "justMyCode": true
        }
    ]
}
