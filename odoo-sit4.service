[Unit]
Description=FastAPI BMS Web Frontend (Odoo SIT4)
After=network.target

[Service]
User=nicku.pasaribu
Group=nicku.pasaribu
WorkingDirectory=/home/nicku.pasaribu/srv/odoo-sit4/bms-web
Environment="PATH=/home/nicku.pasaribu/srv/odoo-sit4/bms-web/venv/bin"
ExecStart=/home/nicku.pasaribu/srv/odoo-sit4/bms-web/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8501
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
